# ---------------------------------------------------------------------------
# Ecclesia — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` (ou `.env.local`) e preencha com valores reais.
# NUNCA versione o arquivo `.env` nem valores reais.
# ---------------------------------------------------------------------------

# URL do PostgreSQL em nuvem (ex.: Neon/Supabase)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Segredo de autenticação (gere com: openssl rand -base64 32)
AUTH_SECRET=

# URL pública da aplicação
# Local: http://localhost:3000 | Producao: https://SEU-DOMINIO.vercel.app
NEXT_PUBLIC_APP_URL=

# Credenciais do usuário administrador inicial (seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=