# ---------------------------------------------------------------------------
# Ecclesia — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` (ou `.env.local`) e preencha com valores reais.
# NUNCA versione o arquivo `.env` nem valores reais.
# ---------------------------------------------------------------------------

# URL do PostgreSQL em nuvem (ex.: Neon/Supabase)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Segredo de autenticação (gere com: openssl rand -base64 32)
AUTH_SECRET=

# URL pública da aplicação
# Local: http://localhost:3000 | Producao: https://SEU-DOMINIO.vercel.app
NEXT_PUBLIC_APP_URL=

# Envio de e-mail para recuperação de senha (Resend)
# Crie uma API key em https://resend.com e verifique o domínio remetente.
RESEND_API_KEY=
EMAIL_FROM=
# Opcional: URL pública do logo exibido no e-mail.
# Se vazio, usa NEXT_PUBLIC_APP_URL + /brand/ecclesia-email-logo.png
EMAIL_LOGO_URL=

# Em desenvolvimento, exibe o link de redefinição na própria tela.
# Nunca habilite em produção.
PASSWORD_RESET_DEV_LINK=false

# Credenciais do usuário administrador inicial (seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Credenciais do Super Admin da plataforma (seed)
# Em produção, defina uma senha forte. Sem ela o Super Admin não é criado.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=